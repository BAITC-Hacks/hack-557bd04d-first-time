# Скопируйте в .env: cp .env.example .env
# Ничего заполнять не обязательно. По умолчанию всё работает локально,
# а без скачанных моделей — в демо-режиме на готовом примере.

# ---- Разбор стенограммы -------------------------------------------------
# demo   — готовый разбор из samples/, эталонный режим для проверки
# local  — локальная модель через Ollama (ollama pull qwen2.5:3b-instruct)
# claude — облако Anthropic, нужен ключ ниже
# Без этой строки: есть ключ — облако, иначе локальная модель, иначе demo.
ANALYSIS_PROVIDER=

ANTHROPIC_API_KEY=
ANALYSIS_MODEL=claude-opus-5
LOCAL_ANALYSIS_MODEL=qwen2.5:3b-instruct

# ---- Распознавание речи -------------------------------------------------
# local (по умолчанию) — модели Vosk из models/, аудио не покидает машину
# soniox — облачное распознавание, нужен ключ ниже
STT_PROVIDER=local
SONIOX_API_KEY=

# 0 отключает разбор двумя моделями (быстрее примерно вдвое, но теряется
# казахская речь внутри русской)
STT_MIXED=1
# Зафиксировать язык (ru/kz) и пропустить пробу
STT_LANGUAGE=

# ---- Разделение говорящих -----------------------------------------------
# Порог склейки голосов: выше — охотнее считает разные реплики одним человеком
DIARIZATION_THRESHOLD=0.70
# Сколько участников ожидать; 0 — определить самостоятельно
DIARIZATION_SPEAKERS=0

# ---- Сервер -------------------------------------------------------------
PORT=8000
