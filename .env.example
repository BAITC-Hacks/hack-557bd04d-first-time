# Скопируйте в .env: cp .env.example .env
# Распознавание речи работает локально и ключей не требует.

# Разбор совещания (Anthropic). Без него — демо-режим на готовом примере.
ANTHROPIC_API_KEY=

# Провайдер распознавания речи: local (по умолчанию) или soniox
STT_PROVIDER=local

# Нужен только если STT_PROVIDER=soniox
SONIOX_API_KEY=

ANALYSIS_MODEL=claude-opus-5
SPEAKER_THRESHOLD=0.62
